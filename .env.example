# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# BREVO_API_KEY: Used for sending contact form emails via Brevo
BREVO_API_KEY="YOUR_BREVO_API_KEY_HERE"

# UX_AUDIT_WEBHOOK_URL / UX_AUDIT_WEBHOOK_SECRET: Server-side only. Each Mini
# UX Audit submission is appended as a row to a Google Sheet by /api/ux-audit,
# through the Apps Script web app in docs/google-sheets-webhook.gs. The secret
# must equal the SECRET constant inside that script. Never expose either to
# the client.
UX_AUDIT_WEBHOOK_URL="https://script.google.com/macros/s/YOUR_DEPLOYMENT_ID/exec"
UX_AUDIT_WEBHOOK_SECRET="A_LONG_RANDOM_STRING"

# TURNSTILE_SECRET_KEY: Server-side only. Used by /api/contact and
# /api/ux-audit to verify Turnstile tokens via Cloudflare's siteverify
# endpoint. Must never be prefixed with VITE_ or referenced from src/ —
# doing so would ship it into the public client bundle.
#
# For local development, Cloudflare publishes fixed test keys that always
# pass verification (documented at
# developers.cloudflare.com/turnstile/troubleshooting/testing/) — set these
# in your own untracked .env.local, never here or in production:
#   TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA
TURNSTILE_SECRET_KEY="YOUR_TURNSTILE_SECRET_KEY_HERE"

# VITE_TURNSTILE_SITE_KEY: Public site key for the Turnstile widget. Safe to
# expose client-side — this is Cloudflare's intended usage for site keys.
# Matching local-dev test site key (always passes, renders a visible widget):
#   VITE_TURNSTILE_SITE_KEY=1x00000000000000000000AA
VITE_TURNSTILE_SITE_KEY="YOUR_TURNSTILE_SITE_KEY_HERE"
